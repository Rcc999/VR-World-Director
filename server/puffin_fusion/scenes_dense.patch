+def strafe_poses(n, step, up):
+    """Slide along the horizontal camera right axis (step < 0 = left)."""
+    right = np.array([1.0, 0.0, 0.0])
+    right = right - (right @ up) * up
+    right /= np.linalg.norm(right)
+    poses = []
+    for i in range(n):
+        P = np.eye(4)
+        P[:3, 3] = right * step * i
+        poses.append(P)
+    return poses
+
+
+def orbit_poses(n, deg_per_view, radius, up):
+    """Turn the seed camera about the vertical axis through a point `radius`
+    ahead of it: the camera circles that point and keeps looking at it."""
+    fwd = np.array([0.0, 0.0, 1.0])
+    fwd = fwd - (fwd @ up) * up
+    fwd /= np.linalg.norm(fwd)
+    c = fwd * radius
+    poses = []
+    for i in range(n):
+        R = rotation(up, math.radians(deg_per_view * i))
+        P = np.eye(4)
+        P[:3, :3] = R
+        P[:3, 3] = c - R @ c
+        poses.append(P)
+    return poses
+
+
