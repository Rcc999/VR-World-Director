# Attribute macros must live in the root .gitattributes; unity/vr-director/.gitattributes uses them.
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Captured photos (data/); raw videos are not in git, see .gitignore
data/**/*.[Jj][Pp][Gg]    lfs
